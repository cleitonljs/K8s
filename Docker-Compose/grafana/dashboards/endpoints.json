{
  "uid": "fcg-api-endpoints",
  "title": "API — Endpoints",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "custom",
        "label": "API",
        "query": "catalog-api, users-api",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "method",
        "type": "query",
        "label": "Método HTTP",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(http_server_request_duration_seconds_count{job=~\"$job\"}, http_request_method)", "refId": "method" },
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "route",
        "type": "query",
        "label": "Endpoint",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(http_server_request_duration_seconds_count{job=~\"$job\"}, http_route)", "refId": "route" },
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "status",
        "type": "query",
        "label": "Status HTTP",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(http_server_request_duration_seconds_count{job=~\"$job\"}, http_response_status_code)", "refId": "status" },
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    { "id": 1, "type": "table", "title": "Top endpoints por volume", "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "topk(10, sum by (job, http_route) (rate(http_server_request_duration_seconds_count{job=~\"$job\", http_request_method=~\"$method\", http_route=~\"$route\", http_response_status_code=~\"$status\"}[$__rate_interval])))", "format": "table", "instant": true, "refId": "A" } ] },
    { "id": 2, "type": "table", "title": "Top endpoints mais lentos (P95)", "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "expr": "topk(10, histogram_quantile(0.95, sum by (le, job, http_route) (rate(http_server_request_duration_seconds_bucket{job=~\"$job\", http_request_method=~\"$method\", http_route=~\"$route\"}[$__rate_interval]))))", "format": "table", "instant": true, "refId": "A" } ] },

    { "id": 3, "type": "table", "title": "Top endpoints com erro (4xx/5xx)", "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "topk(10, sum by (job, http_route) (rate(http_server_request_duration_seconds_count{job=~\"$job\", http_route=~\"$route\", http_response_status_code=~\"4..|5..\"}[$__rate_interval])))", "format": "table", "instant": true, "refId": "A" } ] },
    { "id": 4, "type": "timeseries", "title": "Latência por endpoint (P95)", "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket{job=~\"$job\", http_request_method=~\"$method\", http_route=~\"$route\"}[$__rate_interval])))", "refId": "A", "legendFormat": "{{http_route}}" } ] },

    { "id": 5, "type": "timeseries", "title": "Latência por endpoint (P50 / P95 / P99)", "gridPos": { "h": 9, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket{job=~\"$job\", http_route=~\"$route\"}[$__rate_interval])))", "refId": "A", "legendFormat": "P50 {{http_route}}" },
        { "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket{job=~\"$job\", http_route=~\"$route\"}[$__rate_interval])))", "refId": "B", "legendFormat": "P95 {{http_route}}" },
        { "expr": "histogram_quantile(0.99, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket{job=~\"$job\", http_route=~\"$route\"}[$__rate_interval])))", "refId": "C", "legendFormat": "P99 {{http_route}}" }
      ] },
    { "id": 6, "type": "timeseries", "title": "Erros por endpoint (4xx / 5xx)", "gridPos": { "h": 9, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{job=~\"$job\", http_route=~\"$route\", http_response_status_code=~\"4..\"}[$__rate_interval]))", "refId": "A", "legendFormat": "4xx {{http_route}}" },
        { "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{job=~\"$job\", http_route=~\"$route\", http_response_status_code=~\"5..\"}[$__rate_interval]))", "refId": "B", "legendFormat": "5xx {{http_route}}" }
      ] }
  ]
}
